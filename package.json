{
  "name": "morimizu-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run sync:articles",
    "dev": "vinext dev",
    "prebuild": "npm run sync:articles",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "wrangler deploy --config dist/server/wrangler.json --domain morimizu.dev",
    "sync:articles": "node --env-file-if-exists=.env.local scripts/sync-qiita-articles.mjs",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "gray-matter": "^4.0.3",
    "katex": "^0.18.5",
    "lucide-react": "1.31.0",
    "mermaid": "^11.17.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "19.2.6",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
